                                            @endif

                                            <hr>
                                            <h6>Öneriler</h6>
                                            @php
                                                $recommendations = [];
                                                $utilization = ($customer->credit_limit ?? 0) > 0 ? (($customer->balance ?? 0) / $customer->credit_limit) * 100 : 0;
                                                
                                                if ($utilization > 80) {
                                                    $recommendations[] = "📈 Kredi limitini artırmayı değerlendirin.";
                                                }
                                                if (($customer->balance ?? 0) > 0) {
                                                    $recommendations[] = "📞 Müşteri ile iletişime geçerek ödeme planı oluşturun.";
                                                }
                                                if (($customer->risk_score ?? 0) > 60) {
                                                    $recommendations[] = "🛡️ Teminat veya avans ödemesi talep edin.";
                                                }
                                            @endphp
                                            
                                            @if(empty($recommendations))
                                                <p class="text-muted mb-0">Özel bir öneri bulunmuyor.</p>
                                            @else
                                                @foreach($recommendations as $rec)
                                                    <p class="mb-1">{{ $rec }}</p>
                                                @endforeach
                                            @endif
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Activity Tab -->
                <div class="tab-pane" id="activity" role="tabpanel">
                    <h5 class="font-size-16 mb-3"><i class="mdi mdi-history text-info me-2"></i>Mutabakat Geçmişi</h5>
                    @if($logs && $logs->count())
                        <div class="table-responsive">
                            <table class="table table-nowrap table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Tarih</th>
                                        <th>Eylem</th>
                                        <th>Kullanıcı</th>
                                        <th>E-posta</th>
                                        <th>Dosya</th>
                                        <th>IP Adresi</th>
                                        <th>Notlar</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach($logs as $log)
                                        <tr>
                                            <td>{{ $log->created_at->format('d.m.Y H:i') }}</td>
                                            <td>
                                                <span class="badge badge-soft-{{ $log->action == 'send' ? 'primary' : 'info' }}">
                                                    {{ ucfirst($log->action) }}
                                                </span>
                                            </td>
                                            <td>{{ optional($log->user)->name ?? 'System' }}</td>
                                            <td>{{ $log->email }}</td>
                                            <td>
                                                @if($log->filename)
                                                    <a href="#" class="text-decoration-none">
                                                        <i class="mdi mdi-file-pdf text-danger me-1"></i>{{ $log->filename }}
                                                    </a>
                                                @else
                                                    -
                                                @endif
                                            </td>
                                            <td><small class="text-muted">{{ $log->ip }}</small></td>
                                            <td><small>{{ $log->notes }}</small></td>
                                        </tr>
                                    @endforeach
                                </tbody>
                            </table>
                        </div>
                    @else
                        <div class="text-center py-4">
                            <div class="d-flex flex-column align-items-center">
                                <i class="mdi mdi-history font-size-48 text-muted mb-2"></i>
                                <h5 class="text-muted">Henüz aktivite bulunmuyor</h5>
                                <p class="text-muted">Mutabakat işlemleri burada görünecektir.</p>
                            </div>
                        </div>
                    @endif
                </div>
            </div>
        </div>
    </div>
</div>
