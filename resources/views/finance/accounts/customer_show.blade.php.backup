                                @php $runningBalance = 0; @endphp
                                @forelse($statement as $s)
                                    @php
                                        $isDebit = in_array($s['type'], ['Invoice']);
                                        $amount = $s['amount'];
                                        $runningBalance += $isDebit ? $amount : -$amount;
                                    @endphp
                                    <tr>
                                        <td>{{ $s['date'] ? \Carbon\Carbon::parse($s['date'])->format('d.m.Y') : '-' }}</td>
                                        <td>
                                            @if($s['type'] == 'Invoice')
                                                <span class="badge badge-soft-danger">Fatura</span>
                                            @elseif($s['type'] == 'Receipt')
                                                <span class="badge badge-soft-success">Tahsilat</span>
                                            @else
                                                <span class="badge badge-soft-info">{{ $s['type'] }}</span>
                                            @endif
                                        </td>
                                        <td>{{ $s['notes'] }}</td>
                                        <td class="text-end">
                                            @if($isDebit)
                                                <span class="text-danger">{{ number_format($amount, 2, ',', '.') }} ₺</span>
                                            @else
                                                -
                                            @endif
                                        </td>
                                        <td class="text-end">
                                            @if(!$isDebit)
                                                <span class="text-success">{{ number_format(abs($amount), 2, ',', '.') }} ₺</span>
                                            @else
                                                -
                                            @endif
                                        </td>
                                        <td class="text-end">
                                            <strong class="{{ $runningBalance > 0 ? 'text-danger' : 'text-success' }}">
                                                {{ number_format($runningBalance, 2, ',', '.') }} ₺
                                            </strong>
                                        </td>
                                        <td>
                                            @if($s['type'] == 'Receipt')
