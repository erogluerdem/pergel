@section('scripts')
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Ageing Chart
    const ageingData = @json($ageing ?? ['0-30'=>0,'31-60'=>0,'61-90'=>0,'91_plus'=>0]);
    const ageingValues = Object.values(ageingData);
    const ageingLabels = Object.keys(ageingData).map(key => key.replace('_plus', '+') + ' gün');
    
    const ageingCtx = document.getElementById('ageingChart');
    if (ageingCtx) {
        new Chart(ageingCtx, {
            type: 'doughnut',
            data: {
                labels: ageingLabels,
                datasets: [{
                    data: ageingValues,
                    backgroundColor: ['#28a745', '#ffc107', '#fd7e14', '#dc3545'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            padding: 20,
                            usePointStyle: true
                        }
                    }
                }
            }
        });
    }

    // Payment Trend Chart
    const monthlyTrend = @json($monthlyTrend ?? []);
    const trendLabels = monthlyTrend.map(item => item.month);
    const trendData = monthlyTrend.map(item => item.amount);
    
    const trendCtx = document.getElementById('paymentTrendChart');
    if (trendCtx) {
        new Chart(trendCtx, {
            type: 'line',
            data: {
                labels: trendLabels,
                datasets: [{
                    label: 'Tahsilat (₺)',
                    data: trendData,
                    borderColor: '#28a745',
                    backgroundColor: 'rgba(40, 167, 69, 0.1)',
                    borderWidth: 2,
                    fill: true,
                    tension: 0.4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return new Intl.NumberFormat('tr-TR', {
                                    style: 'currency',
                                    currency: 'TRY'
                                }).format(value);
                            }
                        }
                    }
                }
            }
        });
    }
});

// Utility functions
function exportStatement() {
    // Implementation for exporting statement
    alert('Ekstre dışa aktarma özelliği yakında eklenecek.');
}

function printStatement() {
    window.print();
}

// Enhanced DataTable for statement if needed
if (typeof $ !== 'undefined' && $.fn.DataTable) {
    $(document).ready(function() {
        try {
            $('#statementTable').DataTable({
                dom: 'Bfrtip',
                buttons: ['copy', 'excel', 'pdf', 'print'],
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.11.5/i18n/tr.json'
                },
                order: [[0, 'desc']], // Sort by date descending
                columnDefs: [
                    { targets: [3, 4, 5], className: 'text-end' }
                ]
            });
        } catch (e) {
            console.log('DataTables initialization failed:', e);
        }
    });
}
</script>
@endsection