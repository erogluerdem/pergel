/* Saha Operasyonları - Modern ve Mobil Öncelikli Tasarım */

.field-operations {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background-color: #f8f9fa;
    min-height: 100vh;
}}



/* Ana Kartlar */

.field-operations .card {
    border: none;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    transition: box-shadow 0.3s ease;
}}



.field-operations .card:hover {.field-operations .card:hover {

    box-shadow: 0 4px 16px rgba(0,0,0,0.15);    box-shadow: 0 4px 16px rgba(0,0,0,0.15);

}}



.field-operations .card-header {.field-operations .card-header {

    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);

    color: white;    color: white;

    border-radius: 12px 12px 0 0 !important;    border-radius: 12px 12px 0 0 !important;

    border: none;    border: none;

    padding: 1rem 1.25rem;    padding: 1rem 1.25rem;

}}



/* Takvim *//* Takvim */

#report-calendar {#report-calendar {

    width: 100%;    width: 100%;

    max-width: 100%;    max-width: 100%;

}}



.calendar-day {.calendar-day {

    width: 100%;    width: 100%;

    height: 60px;    height: 60px;

    display: flex;    display: flex;

    align-items: center;    align-items: center;

    justify-content: center;    justify-content: center;

    border-radius: 8px;    border-radius: 8px;

    margin: 2px;    margin: 2px;

    cursor: pointer;    cursor: pointer;

    transition: all 0.2s ease;    transition: all 0.2s ease;

    font-weight: 500;    font-weight: 500;

}}



.calendar-day:hover {.calendar-day:hover {

    transform: scale(1.05);    transform: scale(1.05);

}}



.calendar-day.completed {.calendar-day.completed {

    background-color: #28a745;    background-color: #28a745;

    color: white;    color: white;

}}



.calendar-day.draft {.calendar-day.draft {

    background-color: #ffc107;    background-color: #ffc107;

    color: #212529;    color: #212529;

}}



.calendar-day.empty {.calendar-day.empty {

    background-color: #e9ecef;    background-color: #e9ecef;

    color: #6c757d;    color: #6c757d;

    cursor: default;    cursor: default;

}}



.calendar-day.today {.calendar-day.today {

    border: 2px solid #007bff;    border: 2px solid #007bff;

}}



/* Galeri *//* Galeri */

#media-gallery .media-item {#media-gallery .media-item {

    position: relative;    position: relative;

    border-radius: 8px;    border-radius: 8px;

    overflow: hidden;    overflow: hidden;

    cursor: pointer;    cursor: pointer;

    transition: transform 0.2s ease;    transition: transform 0.2s ease;

}}



#media-gallery .media-item:hover {#media-gallery .media-item:hover {

    transform: scale(1.02);    transform: scale(1.02);

}}



#media-gallery .media-item img,#media-gallery .media-item img,

#media-gallery .media-item video {#media-gallery .media-item video {

    width: 100%;    width: 100%;

    height: 150px;    height: 150px;

    object-fit: cover;    object-fit: cover;

}}



.media-item .media-overlay {.media-item .media-overlay {

    position: absolute;    position: absolute;

    bottom: 0;    bottom: 0;

    left: 0;    left: 0;

    right: 0;    right: 0;

    background: linear-gradient(transparent, rgba(0,0,0,0.7));    background: linear-gradient(transparent, rgba(0,0,0,0.7));

    color: white;    color: white;

    padding: 8px;    padding: 8px;

    font-size: 12px;    font-size: 12px;

}}



.media-item .media-info {.media-item .media-info {

    display: flex;    display: flex;

    justify-content: space-between;    justify-content: space-between;

    align-items: center;    align-items: center;

}}



/* Harita *//* Harita */

#media-map {#media-map {

    border-radius: 8px;    border-radius: 8px;

    height: 400px;    height: 400px;

}}



/* Modal *//* Modal */

.modal-content {.modal-content {

    border-radius: 12px;    border-radius: 12px;

    border: none;    border: none;

    box-shadow: 0 10px 30px rgba(0,0,0,0.3);    box-shadow: 0 10px 30px rgba(0,0,0,0.3);

}}



.modal-header {.modal-header {

    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);

    color: white;    color: white;

    border-radius: 12px 12px 0 0;    border-radius: 12px 12px 0 0;

    border: none;    border: none;

}}



.modal-header .btn-close {.modal-header .btn-close {

    filter: invert(1);    filter: invert(1);

}}



/* Form Elemanları *//* Form Elemanları */

.field-operations .form-control,.field-operations .form-control,

.field-operations .form-select {.field-operations .form-select {

    border-radius: 8px;    border-radius: 8px;

    border: 1px solid #dee2e6;    border: 1px solid #dee2e6;

    padding: 0.5rem 0.75rem;    padding: 0.5rem 0.75rem;

}}



.field-operations .form-control:focus,.field-operations .form-control:focus,

.field-operations .form-select:focus {.field-operations .form-select:focus {

    border-color: #667eea;    border-color: #667eea;

    box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);    box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);

}}



/* Butonlar *//* Butonlar */

.field-operations .btn {.field-operations .btn {

    border-radius: 8px;    border-radius: 8px;

    font-weight: 500;    font-weight: 500;

    padding: 0.5rem 1rem;    padding: 0.5rem 1rem;

    transition: all 0.2s ease;    transition: all 0.2s ease;

}}



.field-operations .btn:hover {.field-operations .btn:hover {

    transform: translateY(-1px);    transform: translateY(-1px);

    box-shadow: 0 4px 8px rgba(0,0,0,0.2);    box-shadow: 0 4px 8px rgba(0,0,0,0.2);

}}



/* İş Gücü ve Ekipman Listeleri *//* İş Gücü ve Ekipman Listeleri */

.labour-item,.labour-item,

.equipment-item,.equipment-item,

.task-item {.task-item {

    background: #f8f9fa;    background: #f8f9fa;

    border-radius: 8px;    border-radius: 8px;

    padding: 1rem;    padding: 1rem;

    margin-bottom: 0.5rem;    margin-bottom: 0.5rem;

    border: 1px solid #dee2e6;    border: 1px solid #dee2e6;

}}



.labour-item .row > div,.labour-item .row > div,

.equipment-item .row > div {.equipment-item .row > div {

    margin-bottom: 0.5rem;    margin-bottom: 0.5rem;

}}



/* Hava Durumu *//* Hava Durumu */

#weather-info {#weather-info {

    padding: 1rem;    padding: 1rem;

}}



.weather-icon {.weather-icon {

    font-size: 3rem;    font-size: 3rem;

    margin-bottom: 0.5rem;    margin-bottom: 0.5rem;

}}



.weather-temp {.weather-temp {

    font-size: 2rem;    font-size: 2rem;

    font-weight: bold;    font-weight: bold;

    margin-bottom: 0.5rem;    margin-bottom: 0.5rem;

}}



.weather-desc {.weather-desc {

    text-transform: capitalize;    text-transform: capitalize;

    margin-bottom: 0.5rem;    margin-bottom: 0.5rem;

}}



.weather-details {.weather-details {

    font-size: 0.9rem;    font-size: 0.9rem;

    color: #6c757d;    color: #6c757d;

}}



/* Mobil Uyumluluk *//* Mobil Uyumluluk */

@media (max-width: 768px) {@media (max-width: 768px) {

    .field-operations .container-fluid {    .field-operations .container-fluid {

        padding: 0.5rem;        padding: 0.5rem;

    }    }



    .calendar-day {    .calendar-day {

        height: 50px;        height: 50px;

        font-size: 14px;        font-size: 14px;

    }    }



    #media-gallery .media-item img,    #media-gallery .media-item img,

    #media-gallery .media-item video {    #media-gallery .media-item video {

        height: 120px;        height: 120px;

    }    }



    .modal-dialog {    .modal-dialog {

        margin: 0.5rem;        margin: 0.5rem;

    }    }

}}



/* Yükleme Animasyonu *//* Yükleme Animasyonu */

.spinner-border {.spinner-border {

    width: 2rem;    width: 2rem;

    height: 2rem;    height: 2rem;

}}



/* Sekmeler *//* Sekmeler */

.nav-tabs .nav-link {.nav-tabs .nav-link {

    border: none;    border: none;

    color: rgba(255,255,255,0.8);    color: rgba(255,255,255,0.8);

    font-weight: 500;    font-weight: 500;

}}



.nav-tabs .nav-link.active {.nav-tabs .nav-link.active {

    background-color: rgba(255,255,255,0.2);    background-color: rgba(255,255,255,0.2);

    color: white;    color: white;

    border-radius: 8px 8px 0 0;    border-radius: 8px 8px 0 0;

}}



.nav-tabs .nav-link:hover {.nav-tabs .nav-link:hover {

    color: white;    color: white;

}}



/* İlerleme Çubuğu *//* İlerleme Çubuğu */

.progress {.progress {

    height: 8px;    height: 8px;

    border-radius: 4px;    border-radius: 4px;

}}



.progress-bar {.progress-bar {

    background: linear-gradient(90deg, #28a745, #20c997);    background: linear-gradient(90deg, #28a745, #20c997);

}}



/* Alert *//* Alert */

.alert {.alert {

    border-radius: 12px;    border-radius: 12px;

    border: none;    border: none;

}}



/* Responsive Grid *//* Responsive Grid */

@media (max-width: 576px) {@media (max-width: 576px) {

    #media-gallery .col-6 {    #media-gallery .col-6 {

        flex: 0 0 50%;        flex: 0 0 50%;

        max-width: 50%;        max-width: 50%;

    }    }

}}

.fo-days {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 0;
    width: 100%;
}

.fo-days .fo-cell {
    /* Use fixed min-height instead of aspect-ratio for better cross-browser support */
    min-height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #eee;
    cursor: pointer;
    font-size: 14px;
    position: relative;
    padding: 6px;
}

.fo-days .fo-cell:hover {
    background-color: #f8f9fa;
}

.fo-days .fo-cell.blank {
    background: #f8f9fa;
    cursor: default;
    color: #ccc;
}

.fo-days .fo-cell.done {
    background: #d4edda;
    color: #155724;
}

.fo-days .fo-cell.draft {
    background: #fff3cd;
    color: #856404;
}

/* MAP - NUCLEAR FIX */
#fo-map {
    height: 400px;
    width: 100%;
    border: 2px solid #007bff;
    border-radius: 8px;
    position: relative;
    background: #f8f9fa;
}

#fo-map:empty::before {
    content: "Harita yükleniyor...";
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: #666;
    font-size: 16px;
}

.leaflet-container {
    height: 100%;
    width: 100%;
    border-radius: 6px;
}

/* GALLERY */
.fo-thumb {
    border: 1px solid #ddd;
    border-radius: 4px;
    padding: 4px;
    margin-bottom: 8px;
    background: white;
}

.fo-thumb img {
    width: 100%;
    height: 120px;
    object-fit: cover;
    border-radius: 2px;
}

/* RESPONSIVE */
@media (max-width: 768px) {
    .fo-days .fo-cell {
        min-height: 35px;
        font-size: 12px;
    }

    #fo-map {
        height: 300px !important;
    }
}

@media (max-width: 576px) {
    .fo-days .fo-cell {
        min-height: 30px;
        font-size: 11px;
    }

    #fo-map {
        height: 250px !important;
    }
}
